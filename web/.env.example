# Copia a .env y completa (los valores reales van SOLO en .env, nunca en git)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...tu-anon-key
# IA: GROQ_API_KEY se configura SOLO en Supabase Edge Secrets, nunca como VITE_*.

# Nombre de la Edge Function de cuentas desplegada en tu proyecto
VITE_PLATFORM_USERS_FUNCTION=quick-service
