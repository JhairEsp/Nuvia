	    '910122334','920233445'];
	  i int; d int; h int; v_status appointment_status; v_method payment_method;
	  v_total numeric(12,2); v_name text; v_slug_exists boolean;
	begin
	  -- ── Usuarios auth + profiles ──────────────────────────────────────────────
	  if not exists (select 1 from auth.users where email = 'super@beautyapp.pe') then
	    insert into auth.users (id, instance_id, aud, role, email, encrypted_password,
	      email_confirmed_at, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
	    values (gen_random_uuid(), '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
	      'super@beautyapp.pe', crypt('Demo123!', gen_salt('bf')), now(),
	      '{"provider":"email","providers":["email"]}'::jsonb, '{"full_name":"Súper Admin"}'::jsonb, now(), now());
	  end if;
	  insert into auth.users (id, instance_id, aud, role, email, encrypted_password,
	    email_confirmed_at, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
	  select gen_random_uuid(), '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
	    e.mail, crypt('Demo123!', gen_salt('bf')), now(),
	    '{"provider":"email","providers":["email"]}'::jsonb,
	    jsonb_build_object('full_name', e.nm), now(), now()
	  from (values
	    ('admin@blackhouse.pe','Ricardo Peña'),
	    ('carlos@blackhouse.pe','Carlos Mendoza'),
	    ('andrea@blackhouse.pe','Andrea Ruiz')
	  ) as e(mail, nm)
	  where not exists (select 1 from auth.users u where u.email = e.mail);
	
	  select id into v_super from auth.users where email = 'super@beautyapp.pe';
	  select id into v_admin from auth.users where email = 'admin@blackhouse.pe';
	  select id into v_carlos_user from auth.users where email = 'carlos@blackhouse.pe';
	  select id into v_andrea_user from auth.users where email = 'andrea@blackhouse.pe';
	
	  update public.users set platform_role = 'SUPER_ADMIN' where id = v_super;
	  update public.users set full_name = 'Ricardo Peña'  where id = v_admin;
	  update public.users set full_name = 'Carlos Mendoza' where id = v_carlos_user;
	  update public.users set full_name = 'Andrea Ruiz'    where id = v_andrea_user;
	
	  -- Contexto de Super Admin para triggers/funciones con auth.uid() durante la siembra
	  perform set_config('request.jwt.claim.sub', v_super::text, true);
	
	  -- ── Planes (Super Admin) ─────────────────────────────────────────────────
	  insert into public.plans (id, code, name, description, price_monthly, limits, modules)
	  values
	    (gen_random_uuid(), 'STARTER', 'Starter', 'Para quien recién comienza', 79.00,
	     '{"max_employees": 5, "max_monthly_appointments": 300, "max_storage_mb": 500}'::jsonb,
	     '{"website": true, "loyalty": false, "ai": false, "whatsapp": false}'::jsonb),
	    (gen_random_uuid(), 'PRO', 'Pro', 'El favorito de los negocios en crecimiento', 149.00,
	     '{"max_employees": 12, "max_monthly_appointments": 2000, "max_storage_mb": 2000}'::jsonb,
	     '{"website": true, "loyalty": true, "ai": true, "whatsapp": true}'::jsonb),
	    (gen_random_uuid(), 'BUSINESS', 'Business', 'Multi-sucursal sin límites', 299.00,
	     '{"max_employees": 50, "max_monthly_appointments": 20000, "max_storage_mb": 10000}'::jsonb,
	     '{"website": true, "loyalty": true, "ai": true, "whatsapp": true, "multibranch": true}'::jsonb)
	  on conflict (code) do nothing;
	  select id into v_plan from public.plans where code = 'PRO';
	
	  -- ── Negocio + sucursal + settings + branding + website ───────────────────
	  select exists (select 1 from public.businesses where slug = 'barberia-black') into v_slug_exists;
	  if not v_slug_exists then
	    insert into public.businesses (id, name, slug, type, status, description, phone, whatsapp, email, address)
	    values (gen_random_uuid(), 'Black House Barber', 'barberia-black', 'BARBERSHOP', 'ACTIVE',
	      'Barbería premium en el corazón de Miraflores. Cortes clásicos y modernos, barba de precisión y una experiencia que se siente como en casa.',
	      '+51 987 654 321', '+51 987 654 321', 'hola@blackhouse.pe', 'Av. La Paz 450, Miraflores, Lima')
	    returning id into v_business;
	  else
	    select id into v_business from public.businesses where slug = 'barberia-black';
	  end if;
	
	  insert into public.locations (business_id, name, address, city, geo, is_default)
	  values (v_business, 'Miraflores', 'Av. La Paz 450, Miraflores', 'Lima',
	          '{"lat": -12.1222, "lng": -77.0300}'::jsonb, true)
	  on conflict do nothing;
	  select id into v_loc from public.locations where business_id = v_business and is_default limit 1;
	
	  insert into public.business_settings (business_id) values (v_business) on conflict do nothing;
	  insert into public.business_branding (business_id, preset, colors, font_key)
	  values (v_business, 'DARK', '{"primary":"#c9a227","button":"#c9a227"}'::jsonb, 'sans')
	  on conflict do nothing;
	  insert into public.business_website (business_id, tagline, socials, map_query)
	  values (v_business, 'Tu estilo comienza aquí.',
	          '{"instagram": "https://instagram.com/blackhouse.barber", "tiktok": "https://tiktok.com/@blackhouse.barber", "facebook": ""}'::jsonb,
	          'Av. La Paz 450, Miraflores, Lima')
	  on conflict do nothing;
	
	  insert into public.subscriptions (business_id, plan_id, status, trial_ends_at)
	  values (v_business, v_plan, 'ACTIVE', now() + interval '14 days')
	  on conflict do nothing;
	
	  -- Horarios: mar–sáb 9–20, dom 9–14, lun cerrado
	  insert into public.business_hours (business_id, location_id, weekday, open_time, close_time, is_closed)
	  select v_business, v_loc, w.d, w.o::time, w.c::time, w.closed
	  from (values (0,'09:00','14:00',false),(1,'09:00','20:00',true),(2,'09:00','20:00',false),
	               (3,'09:00','20:00',false),(4,'09:00','20:00',false),(5,'09:00','21:00',false),
	               (6,'08:00','21:00',false)) as w(d,o,c,closed)
	  where not exists (select 1 from public.business_hours bh
	                    where bh.business_id = v_business and bh.weekday = w.d);
	
	  -- ── Equipo (5 máx. hoy) ─────────────────────────────────────────────────
	  insert into public.employees (id, business_id, location_id, full_name, role_label, specialty, bio, commission_rate, show_on_website)
	  values (gen_random_uuid(), v_business, v_loc, 'Carlos Mendoza', 'Barber', 'Fades y cortes clásicos',
	          '10 años perfeccionando el degradado perfecto.', 10, true),
	         (gen_random_uuid(), v_business, v_loc, 'Andrea Ruiz', 'Stylist', 'Color y estilismo',
	          'Especialista en colorimetría y looks de tendencia.', 12, true),
	         (gen_random_uuid(), v_business, v_loc, 'Luis Fernández', 'Barber', 'Barba y afeitado clásico',
	          'Toalla caliente y precisión de bisturí.', 10, true)
	  on conflict do nothing;
	  select id into v_e_carlos from public.employees where business_id = v_business and full_name = 'Carlos Mendoza';
	  select id into v_e_andrea from public.employees where business_id = v_business and full_name = 'Andrea Ruiz';
	  select id into v_e_luis from public.employees where business_id = v_business and full_name = 'Luis Fernández';
	
	  insert into public.business_users (business_id, user_id, role_code, employee_id, status)
	  values (v_business, v_admin, 'BUSINESS_ADMIN', null, 'ACTIVE'),
	         (v_business, v_carlos_user, 'BARBER', v_e_carlos, 'ACTIVE'),
	         (v_business, v_andrea_user, 'STYLIST', v_e_andrea, 'ACTIVE')
	  on conflict (business_id, user_id) do nothing;
	
	  -- ── Categorías + servicios ──────────────────────────────────────────────
	  insert into public.service_categories (id, business_id, name, position)
	  values (gen_random_uuid(), v_business, 'Cortes', 0), (gen_random_uuid(), v_business, 'Barba', 1)
	  on conflict do nothing;
	  select id into v_cat_cortes from public.service_categories where business_id = v_business and name = 'Cortes';
	  select id into v_cat_barba  from public.service_categories where business_id = v_business and name = 'Barba';
	
	  insert into public.services (id, business_id, category_id, name, description, duration_min, price, position, show_on_website)
	  values (gen_random_uuid(), v_business, v_cat_cortes, 'Corte Premium', 'Corte personalizado con lavado, styling y acabado premium.', 45, 35, 0, true),
	         (gen_random_uuid(), v_business, v_cat_barba, 'Barba', 'Perfilado y arreglo de barba con toalla caliente.', 30, 20, 1, true),
	         (gen_random_uuid(), v_business, null, 'Corte + Barba', 'El combo completo. Sale como nuevo.', 60, 50, 2, true),
	         (gen_random_uuid(), v_business, v_cat_cortes, 'Diseño', 'Diseños y líneas a cuchilla. Arte en tu corte.', 45, 40, 3, true),
	         (gen_random_uuid(), v_business, null, 'Mascarilla Facial', 'Limpieza e hidratación express.', 20, 15, 4, true)
	  on conflict do nothing;
	  select id into v_s_corte  from public.services where business_id = v_business and name = 'Corte Premium';
	  select id into v_s_barba  from public.services where business_id = v_business and name = 'Barba';
	  select id into v_s_combo  from public.services where business_id = v_business and name = 'Corte + Barba';
	  select id into v_s_diseno from public.services where business_id = v_business and name = 'Diseño';
	
	  insert into public.employee_services (employee_id, service_id, business_id)
	  values (v_e_carlos, v_s_corte, v_business), (v_e_carlos, v_s_barba, v_business), (v_e_carlos, v_s_combo, v_business), (v_e_carlos, v_s_diseno, v_business),
	         (v_e_andrea, v_s_corte, v_business), (v_e_andrea, v_s_diseno, v_business),
	         (v_e_luis, v_s_barba, v_business), (v_e_luis, v_s_combo, v_business), (v_e_luis, v_s_corte, v_business)
	  on conflict do nothing;
	
	  -- ── Secciones del website (draft) ───────────────────────────────────────
	  insert into public.website_sections (business_id, type, position, active, content)
	  values
	    (v_business, 'HERO', 0, true,
	     '{"title":"Tu estilo comienza aquí.","subtitle":"Reserva tu próxima experiencia en Black House Barber.","cta":"Reservar cita","cta_enabled":true}'::jsonb),
	    (v_business, 'SERVICES', 1, true, '{"title":"Nuestros servicios"}'::jsonb),
	    (v_business, 'ABOUT', 2, true,
	     '{"title":"Más que una barbería","body":"Desde 2018 cuidamos el estilo de Miraflores con obsesión por el detalle."}'::jsonb),
	    (v_business, 'GALLERY', 3, true, '{"title":"Nuestro trabajo","visible_count":6}'::jsonb),
	    (v_business, 'TEAM', 4, true, '{"title":"Nuestro equipo"}'::jsonb),
	    (v_business, 'PROMOTIONS', 5, true, '{"title":"Promociones"}'::jsonb),
	    (v_business, 'TESTIMONIALS', 6, true, '{"title":"Lo que dicen de nosotros"}'::jsonb),
	    (v_business, 'LOCATION', 7, true, '{"title":"Visítanos"}'::jsonb),
	    (v_business, 'CTA', 8, true, '{"title":"¿Listo para tu próximo look?","cta":"Reservar cita"}'::jsonb),
	    (v_business, 'FOOTER', 9, true, '{}'::jsonb)
	  on conflict (business_id, type) do nothing;
	
	  -- ── Clientes (30) + fidelización ────────────────────────────────────────
	  for i in 1..30 loop
	    insert into public.customers (business_id, full_name, phone, referral_code, birth_date, created_at)
	    values (v_business, v_names[i], v_phones[i],
	            upper(left(regexp_replace(v_names[i], '[^a-zA-Z]', '', 'g'), 4)) || '-' || lpad(i::text, 3, '0'),
	            (date '1985-01-01' + ((i * 37) % 12000)),
	            now() - ((60 - i) || ' days')::interval)
	    on conflict (business_id, phone) do nothing;
	  end loop;
	  select array_agg(id order by created_at) into v_cust_ids
	  from public.customers where business_id = v_business;
	
	  insert into public.loyalty_accounts (business_id, customer_id, points, lifetime_points, tier)
	  select v_business, c.id,
	         (random() * 450)::int, (random() * 900)::int,
	         case when random() > 0.85 then 'GOLD' when random() > 0.6 then 'SILVER' else 'STARTER' end
	  from public.customers c where c.business_id = v_business
	  and not exists (select 1 from public.loyalty_accounts la where la.customer_id = c.id);
	
	  -- ── Citas históricas (6 semanas) + ventas ───────────────────────────────
	  for i in 1..90 loop
	    v_customer := v_cust_ids[1 + (i * 7) % array_length(v_cust_ids, 1)];
	    d := (i * 3) % 42;                       -- días atrás
	    h := 9 + (i * 5) % 11;                   -- 9:00–19:00
	    v_status := case (i % 10)
	      when 0 then 'CANCELLED'::appointment_status
	      when 1 then 'NO_SHOW'::appointment_status
	      when 2 then 'CONFIRMED'::appointment_status
	      else 'COMPLETED'::appointment_status end;
	    if d = 0 and h > 12 then v_status := 'CONFIRMED'; end if;
	
	    v_total := case (i % 4) when 0 then 35 when 1 then 20 when 2 then 50 else 40 end;
	
	    insert into public.appointments (business_id, location_id, customer_id, employee_id, status, source,
	      scheduled_start, scheduled_end, price_total, created_at)
	    values (v_business, v_loc, v_customer,
	            case (i % 3) when 0 then v_e_carlos when 1 then v_e_andrea else v_e_luis end,
	            v_status, case (i % 3) when 0 then 'LANDING'::appointment_source when 1 then 'WHATSAPP'::appointment_source else 'WALK_IN'::appointment_source end,
	            now() - (d || ' days')::interval + ((h - extract(hour from now())) || ' hours')::interval,
	            now() - (d || ' days')::interval + ((h + 1 - extract(hour from now())) || ' hours')::interval,
	            v_total, now() - ((d + 2) || ' days')::interval)
	    returning id into v_appt;
	
	    insert into public.appointment_items (appointment_id, business_id, service_id, employee_id, unit_price, duration_min)
	    select v_appt, v_business, s.id,
	           case (i % 3) when 0 then v_e_carlos when 1 then v_e_andrea else v_e_luis end,
	           s.price, s.duration_min
	    from public.services s
	    where s.id = case (i % 4) when 0 then v_s_corte when 1 then v_s_barba when 2 then v_s_combo else v_s_diseno end;
	
	    if v_status = 'COMPLETED' then
	      v_method := case (i % 4) when 0 then 'CASH' when 1 then 'YAPE' when 2 then 'PLIN' else 'CARD' end;
	      insert into public.sales (business_id, location_id, customer_id, employee_id, appointment_id, status,
	        subtotal, discount_total, total, created_by, created_at)
	      values (v_business, v_loc, v_customer,
	              case (i % 3) when 0 then v_e_carlos when 1 then v_e_andrea else v_e_luis end,
	              v_appt, 'PAID', v_total, 0, v_total, v_admin, now() - (d || ' days')::interval)
	      returning id into v_sale;
	
	      insert into public.sale_items (sale_id, business_id, item_type, service_id, description, qty, unit_price, total, employee_id)
	      select v_sale, v_business, 'SERVICE', s.id, s.name, 1, s.price, s.price,
	             case (i % 3) when 0 then v_e_carlos when 1 then v_e_andrea else v_e_luis end
	      from public.services s
