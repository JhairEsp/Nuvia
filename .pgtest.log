	    returning id into v_appt;
	
	    insert into public.appointment_items (appointment_id, business_id, service_id, employee_id, unit_price, duration_min)
	    select v_appt, v_business, s.id,
	           case (i % 3) when 0 then v_e_carlos when 1 then v_e_andrea else v_e_luis end,
	           s.price, s.duration_min
	    from public.services s
	    where s.id = case (i % 4) when 0 then v_s_corte when 1 then v_s_barba when 2 then v_s_combo else v_s_diseno end;
	
	    if v_status = 'COMPLETED' then
	      v_method := case (i % 4) when 0 then 'CASH' when 1 then 'YAPE' when 2 then 'PLIN' else 'CARD' end;
	      insert into public.sales (business_id, location_id, customer_id, employee_id, appointment_id, status,
	        subtotal, discount_total, total, created_by, created_at)
	      values (v_business, v_loc, v_customer,
	              case (i % 3) when 0 then v_e_carlos when 1 then v_e_andrea else v_e_luis end,
	              v_appt, 'PAID', v_total, 0, v_total, v_admin, now() - (d || ' days')::interval)
	      returning id into v_sale;
	
	      insert into public.sale_items (sale_id, business_id, item_type, service_id, description, qty, unit_price, total, employee_id)
	      select v_sale, v_business, 'SERVICE', s.id, s.name, 1, s.price, s.price,
	             case (i % 3) when 0 then v_e_carlos when 1 then v_e_andrea else v_e_luis end
	      from public.services s
	      where s.id = case (i % 4) when 0 then v_s_corte when 1 then v_s_barba when 2 then v_s_combo else v_s_diseno end;
	
	      insert into public.payments (sale_id, business_id, method, amount, reference, created_by)
	      values (v_sale, v_business, v_method, v_total,
	              case when v_method in ('YAPE','PLIN') then 'OP-' || lpad(i::text, 6, '0') else '' end, v_admin);
	
	      insert into public.commissions (business_id, employee_id, sale_item_id, base_amount, rate, amount, status)
	      select v_business, si.employee_id, si.id, si.total,
	             coalesce(e.commission_rate, 10), round(si.total * coalesce(e.commission_rate, 10) / 100.0, 2),
	             case when d > 7 then 'PAID' else 'PENDING' end
	      from public.sale_items si
	      left join public.employees e on e.id = si.employee_id
	      where si.sale_id = v_sale;
	    end if;
	  end loop;
	
	  -- Citas futuras (próximos 7 días)
	  for i in 1..12 loop
	    v_customer := v_cust_ids[1 + (i * 11) % array_length(v_cust_ids, 1)];
	    insert into public.appointments (business_id, location_id, customer_id, employee_id, status, source,
	      scheduled_start, scheduled_end, price_total, created_by)
	    values (v_business, v_loc, v_customer,
	            case (i % 3) when 0 then v_e_carlos when 1 then v_e_andrea else v_e_luis end,
	            case when i % 2 = 0 then 'CONFIRMED' else 'PENDING' end,
	            case (i % 2) when 0 then 'LANDING' else 'WHATSAPP' end,
	            now() + ((i / 2) || ' days')::interval + ((i % 5) || ' hours')::interval,
	            now() + ((i / 2) || ' days')::interval + ((i % 5) + 1 || ' hours')::interval,
	            case (i % 3) when 0 then 35 when 1 then 50 else 20 end, v_admin);
	  end loop;
	
	  -- ── Inventario ───────────────────────────────────────────────────────────
	  insert into public.products (business_id, name, sku, category, price, cost, stock, stock_min)
	  values (v_business, 'Pomada Mate Black House', 'BH-POM-001', 'Styling', 65, 32, 18, 5),
	         (v_business, 'Cera Texturizadora', 'BH-CER-002', 'Styling', 55, 26, 4, 5),
	         (v_business, 'Aceiente para Barba', 'BH-ACE-003', 'Barba', 48, 22, 12, 4),
	         (v_business, 'Shampoo Fortalecedor', 'BH-SHA-004', 'Cuidado', 42, 19, 0, 3)
	  on conflict (business_id, sku) do nothing;
	
	  -- ── Fidelización · referidos · promos · testimonios ──────────────────────
	  insert into public.loyalty_transactions (business_id, account_id, type, points, reason)
	  select v_business, la.id, 'EARN', 50, 'Cita completada'
	  from public.loyalty_accounts la where la.business_id = v_business
	  limit 15;
	
	  insert into public.referrals (business_id, code, referrer_customer_id, referred_customer_id, status, reward_points, completed_at)
	  values (v_business, 'MARIA-458', v_cust_ids[1], v_cust_ids[2], 'REWARDED', 100, now() - interval '10 days'),
	         (v_business, 'JOSE-212', v_cust_ids[3], v_cust_ids[4], 'COMPLETED', 100, now() - interval '3 days')
	  on conflict (business_id, code) do nothing;
	
	  insert into public.promotions (business_id, service_id, name, description, price, discount_percent, starts_at, ends_at, show_on_website)
	  values (v_business, v_s_combo, 'Martes Beauty', 'Corte + Barba + Mascarilla a precio especial.',
	          70, 17, current_date - 7, current_date + 30, true),
	         (v_business, v_s_corte, 'Padre e hijo', 'Dos cortes premium. Padre e hijo juntos.',
	          60, 14, current_date - 7, current_date + 30, true)
	  on conflict do nothing;
	
	  insert into public.reviews (business_id, customer_id, author_name, rating, content, is_published)
	  values (v_business, v_cust_ids[1], 'María F.', 5, 'El mejor servicio de Lima. Salí como nuevo y la atención es de otro nivel.', true),
	         (v_business, v_cust_ids[5], 'Jorge C.', 5, 'Carlos entiende exactamente lo que quieres. Ya no voy a otro lado.', true),
	         (v_business, null, 'Renzo G.', 4, 'Ambiente increíble y precios justos. Recomendadísimo.', true)
	  on conflict do nothing;
	
	  -- ── Automatizaciones WhatsApp ────────────────────────────────────────────
	  insert into public.automation_rules (business_id, name, trigger_event, channel, template, delay_minutes)
	  values (v_business, 'Confirmación de cita', 'APPOINTMENT_CREATED', 'WHATSAPP',
	          'Hola {{cliente}}, tu cita de {{servicio}} está registrada para el {{fecha}} a las {{hora}}. ¡Te esperamos!', 5),
	         (v_business, 'Recordatorio 24 h', 'REMINDER_24H', 'WHATSAPP',
	          'Hola {{cliente}}, te recordamos tu cita mañana a las {{hora}}. ¿Confirmamos?', 0),
	         (v_business, 'Gracias post-visita', 'APPOINTMENT_COMPLETED', 'WHATSAPP',
	          'Gracias por visitarnos, {{cliente}}. ¡Nos vemos la próxima!', 60),
	         (v_business, 'Rebooking 28 días', 'CUSTOMER_AT_RISK', 'WHATSAPP',
	          'Hola {{cliente}}, ¿ya es momento de tu próxima visita? Reserva aquí: {{link}}', 0),
	         (v_business, 'Hueco liberado', 'WAITLIST_SLOT_OPENED', 'WHATSAPP',
	          '¡Hola {{cliente}}! Se liberó un horario compatible: {{fecha}} a las {{hora}}. ¿Lo tomamos?', 0)
	  on conflict do nothing;
	
	  -- ── Waitlist + at-risk de ejemplo + insights IA sembrados ────────────────
	  insert into public.waitlist (business_id, customer_id, service_id, employee_id, preferred_date, time_start, time_end, priority)
	  values (v_business, v_cust_ids[7], v_s_corte, v_e_carlos, current_date + 3, '17:00', '20:00', 1),
	         (v_business, v_cust_ids[9], v_s_combo, null, current_date + 3, '16:00', '21:00', 0),
	         (v_business, v_cust_ids[12], v_s_barba, v_e_luis, null, null, null, 0)
	  on conflict do nothing;
	
	  insert into public.ai_insights (business_id, type, severity, title, body, data)
	  values (v_business, 'AT_RISK', 'warning',
	          '6 clientes fuera de su frecuencia habitual',
	          'Detectamos 6 clientes que suelen regresar entre 21 y 30 días y actualmente están fuera de su frecuencia. Recomendamos enviarles un recordatorio personalizado.',
	          '{"customer_ids": ["..."], "action": "view_clients"}'::jsonb),
	         (v_business, 'WEAK_SLOTS', 'info',
	          'Los martes tienen menor ocupación (41%)',
	          'Los martes entre 2:00 y 5:00 PM son los huecos más débiles. Una promo express podría levantar la ocupación un 15%.',
	          '{"dow": 2, "hours": [14,15,16,17]}'::jsonb),
	         (v_business, 'OPPORTUNITY', 'info',
	          'Corte + Barba es tu combo más rentable',
	          'Representa el 38% de los ingresos. Sugiere ofrecerlo como upsell automático al reservar solo corte.',
	          '{"service": "Corte + Barba"}'::jsonb);
	
	  -- Publicar el sitio con la RPC real (snapshot completo) como el Business Admin
	  if not exists (select 1 from public.website_releases wr where wr.business_id = v_business) then
	    perform set_config('request.jwt.claim.sub', v_admin::text, true);
	    perform public.publish_website(v_business);
	    perform set_config('request.jwt.claim.sub', v_super::text, true);
	  end if;
	
	  -- Stats de clientes
	  perform public.refresh_customer_stats(v_business);
	
	  raise notice '✅ Seed BLACK HOUSE BARBER completado (negocio: %)', v_business;
	end $$;
